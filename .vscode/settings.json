{
    "files.associations": {
        "*.h": "c",
        "*.c": "c",
        "*.cpp": "cpp",
        "*.hpp": "cpp",
    },
    "files.insertFinalNewline": true,
    "files.trimTrailingWhitespace": true,
    "editor.wordWrapColumn": 100,
    "cmake.sourceDirectory": "${workspaceFolder}",
    "cmake.cmakePath": "cmake",
    "sonarlint.pathToCompileCommands": "${workspaceFolder}/build/weact_c3/zephyr/Debug/test_profile/compile_commands.json",
    "idf.pythonInstallPath": "/usr/bin/python3",
    "clangd.arguments": [
        "--query-driver=**/*riscv32*,**/*gcc*"
    ]
}
