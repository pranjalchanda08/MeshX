{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "gdbtarget",
            "request": "attach",
            "name": "Eclipse CDT GDB Adapter",
            "program": "${workspaceFolder}/build/xiao_c3/Debug/all_in_one/meshx_build_xiao_c3.elf",
            "initCommands": [
                "set remote hardware-watchpoint-limit 4",
                "mon reset halt",
                "maintenance flush register-cache",
                "thb app_main"
            ],
            "gdb": "${command:espIdf.getToolchainGdb}",
            "target": {
                "connectCommands": [
                    "set remotetimeout 20",
                    "-target-select extended-remote localhost:3333"
                ]
            }
        },
        {
            "type": "gdb",
            "request": "attach",
            "name": "Native GDB",
            "executable": "${workspaceFolder}/build/xiao_c3/Debug/all_in_one/meshx_build_xiao_c3.elf",
            "gdbpath": "/home/pranjal/.espressif/tools/riscv32-esp-elf-gdb/14.2_20240403/riscv32-esp-elf-gdb/bin/riscv32-esp-elf-gdb",
            "target": "extended-remote :3333",
            "cwd": "${workspaceRoot}",
            "valuesFormatting": "parseText",
            "autorun": [
                "mon reset halt",
                "maintenance flush register-cache",
                "thb model_send"
            ]
        },
        {
            "name": "GDB",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            "miDebuggerPath": "/home/pchanda/.espressif/tools/riscv32-esp-elf-gdb/14.2_20240403/riscv32-esp-elf-gdb/bin/riscv32-esp-elf-gdb",
            "program": "${workspaceFolder}/build/xiao_c3/Debug/all_in_one/meshx_build_xiao_c3.elf",
            "cwd": "${workspaceFolder}",
            "miDebuggerServerAddress": "localhost:3333",
            "useExtendedRemote": true,
            "setupCommands": [
                {
                    "text": "set remotetimeout 20"
                }
            ],
            "postRemoteConnectCommands": [
                {
                    "text": "mon reset halt"
                },
                {
                    "text": "maintenance flush register-cache"
                },
                // {
                //     "text": "thb app_main"
                // }
            ],
            "externalConsole": false,
            "logging": {
                "engineLogging": true
            }
        }
    ]
}
