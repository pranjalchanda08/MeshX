/*
 * Copyright (c) 2024 - 2026 MeshX
 * SPDX-License-Identifier: Apache-2.0
 *
 * Board-specific DeviceTree IO Overlay for WeAct ESP32-C3 BSP.
 * Defines board-fixed peripherals (Status LED, Boot Button, USB CDC Serial)
 * and exposes breakout pins generically by GPIO number. Runtime role
 * configuration is driven top-down by MeshX IO firmware and prod_profile.yml.
 */

/ {
	chosen {
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
	};

	aliases {
		led0 = &blue_status_led;
		sw0 = &boot_button;

		/* Generic GPIO pin aliases */
		gpio0  = &pin_gpio0;
		gpio1  = &pin_gpio1;
		gpio2  = &pin_gpio2;
		gpio3  = &pin_gpio3;
		gpio4  = &pin_gpio4;
		gpio5  = &pin_gpio5;
		gpio6  = &pin_gpio6;
		gpio7  = &pin_gpio7;
		gpio10 = &pin_gpio10;
		gpio12 = &pin_gpio12;
		gpio13 = &pin_gpio13;
		gpio14 = &pin_gpio14;
		gpio15 = &pin_gpio15;
		gpio16 = &pin_gpio16;
		gpio17 = &pin_gpio17;
	};

	leds {
		compatible = "gpio-leds";

		blue_status_led: led_0 {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			label = "WeAct Blue Status LED (GPIO8)";
		};

		/* Generic Breakout GPIO Pin Nodes */
		pin_gpio0: gpio_0 {
			gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
			label = "GPIO 0";
		};

		pin_gpio1: gpio_1 {
			gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
			label = "GPIO 1";
		};

		pin_gpio2: gpio_2 {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "GPIO 2";
		};

		pin_gpio3: gpio_3 {
			gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
			label = "GPIO 3";
		};

		pin_gpio4: gpio_4 {
			gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;
			label = "GPIO 4";
		};

		pin_gpio5: gpio_5 {
			gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;
			label = "GPIO 5";
		};

		pin_gpio6: gpio_6 {
			gpios = <&gpio0 6 GPIO_ACTIVE_HIGH>;
			label = "GPIO 6";
		};

		pin_gpio7: gpio_7 {
			gpios = <&gpio0 7 GPIO_ACTIVE_HIGH>;
			label = "GPIO 7";
		};

		pin_gpio10: gpio_10 {
			gpios = <&gpio0 10 GPIO_ACTIVE_HIGH>;
			label = "GPIO 10";
		};

		pin_gpio12: gpio_12 {
			gpios = <&gpio0 12 GPIO_ACTIVE_HIGH>;
			label = "GPIO 12";
		};

		pin_gpio13: gpio_13 {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
			label = "GPIO 13";
		};

		pin_gpio14: gpio_14 {
			gpios = <&gpio0 14 GPIO_ACTIVE_HIGH>;
			label = "GPIO 14";
		};

		pin_gpio15: gpio_15 {
			gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;
			label = "GPIO 15";
		};

		pin_gpio16: gpio_16 {
			gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
			label = "GPIO 16";
		};

		pin_gpio17: gpio_17 {
			gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
			label = "GPIO 17";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";

		boot_button: button_boot {
			label = "Boot Button (GPIO9)";
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};
};

&usb_serial {
	status = "okay";
};
