[sections:element_table]
entries:
    .element_table

[sections:meshx_log_str]
entries:
    .meshx_log_str+

[scheme:meshx_elements]
entries:
    element_table -> flash_rodata

[scheme:meshx_log]
entries:
    meshx_log_str -> flash_rodata

[mapping:meshx]
archive: *
entries:
    * (meshx_elements);
        element_table -> flash_rodata KEEP() ALIGN(4) SURROUND(element_table)
    * (meshx_log);
        meshx_log_str -> flash_rodata KEEP() ALIGN(4)
